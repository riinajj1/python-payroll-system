def custom_split(sentence, separator):

    result_list = []
    current_word = ""

    for character in sentence:

        if character == separator:
            result_list.append(current_word)
            current_word = ""

        else:
            current_word += character

    result_list.append(current_word)
    return result_list


def custom_join(result_list, separator):

    result = ""

    for i in range(len(result_list)):
        result += result_list[i]

        if i < len(result_list) - 1:
            result += separator

    return result

class PayrollSystem:
    def calculate_payroll(self, employees):
        for employee in employees:
            print("Payroll report")
            print("==============")
            print(f"Employee: {employee.employee_id} - {employee.name}")
            print(f"- Salary: {employee.calculate_salary()}")
            print("")


class Employee:
    def __init__(self, employee_id, name):
        self.employee_id = employee_id
        self.name = name


class SalariedEmployee(Employee):
    def __init__(self, employee_id, name, monthly_salary):
        super().__init__(employee_id, name)
        self.salary_type = "M"
        self.monthly_salary = int(monthly_salary)

    def calculate_salary(self):
        return self.monthly_salary
        

class HourlyEmployee(Employee):
    def __init__(self, employee_id, name, hours_worked, hour_rate):
        super().__init__(employee_id, name)
        self.salary_type = "H"
        self.hours_worked = int(hours_worked)
        self.hour_rate = int(hour_rate)

    def calculate_salary(self):
        return self.hours_worked * self.hour_rate
        

class CommissionEmployee(SalariedEmployee):
    def __init__(self, employee_id, name, monthly_salary, commission):
        super().__init__(employee_id, name, monthly_salary)
        self.salary_type = "C"
        self.commission = int(commission)

    def calculate_salary(self):
        return self.monthly_salary + self.commission
    
employees = []
employee_id = 1
        
while True:

    print("(1) Add employees\n(2) Save employees to file\n(3) Load employees from file\n(4) Print payroll report\n(0) Exit\n")
    
    choice = input("Select action: ")


    if choice == "1":

        while True:
            salary_type = input("Select salary type:\n(1) Monthly\n(2) Hourly\n(3) Commission\n(0) Back\n")

            if salary_type == "0":
                break

            employee_name = input("Enter employee name: ")

            if salary_type == "1":
                monthly_salary = int(input("Enter monthly salary: "))
                employee = SalariedEmployee(employee_id, employee_name, monthly_salary)

            elif salary_type == "2":
                hours_worked = int(input("Enter hours worked: "))
                hour_rate = int(input("Enter hourly rate: "))

                employee = HourlyEmployee(employee_id, employee_name, hours_worked, hour_rate)

            elif salary_type == "3":
                monthly_salary = int(input("Enter monthly salary: "))
                commission = int(input("Enter commission: "))

                employee = CommissionEmployee(employee_id, employee_name, monthly_salary, commission)

            else:
                print("Invalid selection.")
                continue

            employees.append(employee)
            employee_id += 1


    elif choice == "2":
        file = open("employee.csv", "w")

        for employee in employees:

            if employee.salary_type == "M":
                row = [str(employee.employee_id), employee.name, "M", str(employee.monthly_salary)]

            elif employee.salary_type == "H":
                row = [str(employee.employee_id), employee.name, "H", str(employee.hours_worked), str(employee.hour_rate)]

            elif employee.salary_type == "C":
                row = [str(employee.employee_id), employee.name, "C", str(employee.monthly_salary), str(employee.commission)]
            
            file.write(custom_join(row, ",")+ "\n")

        file.close()

        employee_id = len(employees) + 1

        print(len(employees), 
              " employee(s) saved to employee.csv")


    elif choice == "3":

        file = open("employee.csv", "r")

        employees = []

        for row in file:
            row = row.strip()

            if row != "":
                data = custom_split(row, ",")

                if data[2] == "M":
                    employee = SalariedEmployee(int(data[0]), data[1], int(data[3]))

                elif data[2] == "H":
                    employee = HourlyEmployee(int(data[0]), data[1], int(data[3]), int(data[4]))

                elif data[2] == "C":
                    employee = CommissionEmployee(int(data[0]), data[1], int(data[3]), int(data[4]))

                employees.append(employee)

        file.close()

        employee_id = len(employees) + 1

        print(len(employees), 
              " employee(s) loaded from employee.csv")


    elif choice == "4":
        payroll_system = PayrollSystem()
        payroll_system.calculate_payroll(employees)


    elif choice == "0":
        print("Application closed. Thank you.")
        break

    else:
        print("Invalid selection.")
